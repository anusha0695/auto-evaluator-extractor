# =============================================================================
# extractor — environment variables template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ----- GCP project + auth -----
GCP_PROJECT_ID=medical-report-extraction
GCP_REGION=us-central1
# Path to the JSON key for the pipeline service account, OR leave unset to use
# Application Default Credentials (`gcloud auth application-default login`).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# ----- DocAI Layout Parser -----
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=81e83f6783d90bb0
DOCAI_PROCESSOR_VERSION=pretrained-layout-parser-v1.6-2026-01-13

# ----- Gemini backend (langchain-google-genai 4.2.2 / google-genai SDK) -----
# The wrapper supports TWO backends behind one API; flip the flag to switch.
#
#   GOOGLE_GENAI_USE_VERTEXAI=false  → Google AI Studio (dev). Uses GOOGLE_API_KEY.
#                                       NOT BAA-covered. Use ONLY with synthetic
#                                       test data — never real PHI.
#   GOOGLE_GENAI_USE_VERTEXAI=true   → Vertex AI (prod). Uses GCP_PROJECT_ID +
#                                       VERTEX_LOCATION + Application Default
#                                       Credentials. BAA-covered. PHI-safe.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=medical-report-extraction       # used by google-genai when VERTEXAI=true
GOOGLE_CLOUD_LOCATION=us-central1                    # used by google-genai when VERTEXAI=true
# GOOGLE_API_KEY=...                                 # only set when VERTEXAI=false (dev)

VERTEX_LOCATION=us-central1                          # legacy alias for our own code
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# Locked at 0.0 per project policy — do NOT change without sign-off.
GEMINI_TEMPERATURE=0.0

# ----- Persistence backend -----
# `local`    → runs / extractions / artifacts written to local_runs/ on disk.
#              No GCS bucket or BigQuery dataset required. Recommended while
#              you're iterating on prompts before GCP is fully provisioned.
# `bigquery` → runs + extractions to BigQuery, artifacts to GCS. Production
#              destination. Flip this when GCP-side provisioning is done.
PERSISTENCE_BACKEND=local

# ----- GCS bucket layout (used when PERSISTENCE_BACKEND=bigquery) -----
GCS_BUCKET=patient_clinical_trial
GCS_INPUT_PREFIX=patient_profiles/
GCS_ARTIFACTS_PREFIX_PHASE_1=extraction_outputs/phase1/

# ----- BigQuery (used when PERSISTENCE_BACKEND=bigquery) -----
BQ_DATASET=extractor_dev
BQ_RUNS_TABLE_PHASE_1=runs_v1
BQ_EXTRACTIONS_TABLE_PHASE_1=extractions_v1

# ----- Firestore checkpointer -----
FIRESTORE_DATABASE=(default)
FIRESTORE_CHECKPOINT_COLLECTION=langgraph_checkpoints_phase1

# ----- Observability -----
# All three default to FALSE for local dev. Set to true ONE AT A TIME after
# the matching IAM role is granted to the service account:
#   CLOUD_TRACE_ENABLED      → roles/cloudtrace.agent
#   CLOUD_LOGGING_ENABLED    → roles/logging.logWriter
#   CLOUD_MONITORING_ENABLED → roles/monitoring.metricWriter
# Otherwise you'll see `PermissionDenied 403` noise on every export.
OTEL_SERVICE_NAME=extractor-pipeline
OTEL_RESOURCE_ATTRIBUTES=service.namespace=medical-report-extraction
CLOUD_TRACE_ENABLED=false
CLOUD_LOGGING_ENABLED=false
CLOUD_MONITORING_ENABLED=false

# ----- Feature flags -----
# All-or-nothing preprocessing: if any of DocAI / fax_filter / Block Profiler / NER fails,
# route to SME rather than proceeding with partial state.
PREPROCESS_ALL_OR_NOTHING=true
# Auto-accept threshold for MetadataTeam llm_confidence_score in Phase 1.
AUTO_ACCEPT_CONFIDENCE_THRESHOLD=0.85

# ----- Local dev -----
# When set, scripts/process_local.py reads the PDF from this local path instead of GCS.
# Useful for iterating on demo.pdf without re-uploading.
# LOCAL_PDF_PATH=/Users/maverick/Documents/Anusha/Unstructured/agentic_evaluation/data/actual_docs/demo.pdf
