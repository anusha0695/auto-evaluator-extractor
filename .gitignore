# ----- Pipeline scratch (never commit real PHI) -----
# Local runs may emit cached DocAI responses or pipeline traces with PHI.
# Anything that holds real patient data should be excluded here.
local_runs/
local_artifacts/
scratch/
*.pdf.cache
docai_response_*.json

# ----- Snapshots (these ARE committed — explicit allow) -----
!snapshots/
!snapshots/**

# ----- Ground truth (this IS committed — explicit allow) -----
!ground_truth/
!ground_truth/**

# ----- Logs -----
*.log
logs/
setup.log

# ----- Production-prompt screenshots (may contain PHI from sample reports) -----
prod_prompt_data/

# ----- Office lockfiles -----
~$*.docx
~$*.xlsx
~$*.pptx

# ----- Pipeline persistence (local backend writes here; never commit) -----
local_runs/
local_artifacts/

